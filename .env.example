# Arsenal eticketing credentials
EMAIL=your-email@example.com
PASSWORD=your-password

# Ticket settings
QUANTITY=1
TOGETHER=true

# Price filter (in GBP)
MIN_PRICE=0
MAX_PRICE=100

# Telegram notifications
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Polling intervals (ms)
POLL_MIN_INTERVAL_MS=500
POLL_MAX_INTERVAL_MS=10000
POLL_INITIAL_INTERVAL_MS=2000

# Optional: preferred blocks (comma-separated, e.g. "Block 1,Block 2")
PREFERRED_BLOCKS=
